/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self' mailto:; script-src 'self' __THEME_SCRIPT_HASH__ https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'self' https://cloud.umami.is https://api-gateway.umami.dev https://secretary.danilostoletovic.com

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=86400

/profile.md
  Content-Type: text/markdown; charset=utf-8

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

/cv.pdf
  Content-Type: application/pdf

/academia/:id/citation.bib
  Content-Type: application/x-bibtex; charset=utf-8

/academia/:id/citation.ris
  Content-Type: application/x-research-info-systems; charset=utf-8

/deployment-version.txt
  Cache-Control: no-store
