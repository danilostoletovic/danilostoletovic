---
import { budgetPlanner } from '../data/budget';
import { person } from '../data/public';
import { formAttributes, webmcpForms } from '../config/webmcp';
const { minimum, maximum, step, scopes } = budgetPlanner;
const tool = webmcpForms.budget;
---
<section class="panel" id="budget" aria-labelledby="budget-title">
  <h2 id="budget-title">Budget estimator</h2>
  <p>Set the budget you have in mind and see an example scope. Final scope and pricing are agreed directly.</p>
  <form class="form" id="budget-form" {...formAttributes(tool)} hidden>
    <label for="project-type">What are you planning?</label>
    <select id="project-type" name="scope" {...{ toolparamdescription: tool.fields.scope }} required>{scopes.map(scope => <option value={scope.name}>{scope.name}</option>)}</select>
    <label for="project-budget">Your budget in euros</label>
    <input type="number" min={minimum} max={maximum} step={step} value={minimum} id="project-budget" name="budget" {...{ toolparamdescription: tool.fields.budget }} required />
  </form>
  <output class="output" id="budget-example" for="project-type project-budget" hidden></output>
  <a class="button secondary" id="budget-inquiry" href={`mailto:${person.email}?subject=Project%20inquiry`}>Email your project brief</a>
  <script>
    import { budgetPlanner } from '../data/budget';
    import { estimateBudget, euros } from '../lib/budget-estimate';
    const form = document.querySelector<HTMLFormElement>('#budget-form');
    const type = document.querySelector<HTMLSelectElement>('#project-type');
    const amount = document.querySelector<HTMLInputElement>('#project-budget');
    const output = document.querySelector<HTMLOutputElement>('#budget-example');
    const inquiry = document.querySelector<HTMLAnchorElement>('#budget-inquiry');
    if (form && type && amount && output && inquiry) {
      const address = inquiry.href.split('?')[0];
      const update = () => {
        const estimate = estimateBudget(type.value, amount.valueAsNumber);
        if (!estimate) {
          output.textContent = `Enter a budget from ${euros.format(budgetPlanner.minimum)} to ${euros.format(budgetPlanner.maximum)} in ${euros.format(budgetPlanner.step)} steps.`;
          inquiry.href = `${address}?subject=Project%20inquiry`;
          return;
        }
        output.textContent = `${estimate.display} planning budget · ${estimate.scope}`;
        const body = `Project: ${estimate.project}\nPlanning budget: ${estimate.display}\n\nWhat I’d like to build:\n`;
        inquiry.href = `${address}?subject=Project%20inquiry&body=${encodeURIComponent(body)}`;
        return estimate;
      };
      form.addEventListener('input', update);
      form.addEventListener('submit', event => {
        event.preventDefault();
        const estimate = update();
        const toolEvent = event as SubmitEvent & { agentInvoked?: boolean; respondWith?: (result: Promise<unknown>) => void };
        if (toolEvent.agentInvoked) toolEvent.respondWith?.(Promise.resolve(estimate ?? { error: 'Invalid budget or project type.' }));
      });
      update();
      form.hidden = output.hidden = false;
    }
  </script>
</section>
