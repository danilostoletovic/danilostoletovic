---
import type { GetStaticPaths } from 'astro';
import Site from '../../layouts/Site.astro';
import PageHeading from '../../components/PageHeading.astro';
import Sources from '../../components/Sources.astro';
import { catalogue, projectPath } from '../../lib/catalogue';
import { author } from '../../lib/seo';
export const getStaticPaths = (() => catalogue['case-studies'].map(study => ({ params: { id: study.id }, props: { study } }))) satisfies GetStaticPaths;
const { study } = Astro.props;
const project = catalogue.projects.find(project => project.id === study.project)!;
const parts = [
  ['Problem', study.problem], ['Requirements & constraints', study.constraints], ['My role', project.role],
  ['Technical decisions', study.decisions], ['Implementation', study.implementation],
  ['Results', study.results], ['Lessons learned', study.lessons],
];
const entities = [{ '@type': 'Article', '@id': study.url + '#article', url: study.url, headline: study.title, description: study.summary, author, about: { '@id': project.url + '#project' } }];
---
<Site title={study.title} description={study.summary} section={{ name: 'Case studies', path: '/case/' }} {entities}>
  <PageHeading title={study.title} description={study.summary} />
  <article class="split">
    <div class="prose stack">
      {parts.map(([title, content]) => <section><h2>{title}</h2><p>{content}</p></section>)}
    </div>
    <aside class="stack" aria-label="Project and evidence">
      <section class="panel">
        <h2>{project.title}</h2>
        <p>{project.summary}</p>
        <a href={projectPath(project.id)}>Project details</a>
      </section>
      {project.image && <figure class="project-shot"><img src={project.image.file} alt={project.image.alt} width={project.image.width} height={project.image.height} decoding="async" /></figure>}
      <Sources links={study.sources} title="Sources" />
    </aside>
  </article>
</Site>
