---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import { directories, telephoneHref, telephoneLabel } from '../lib/catalogue';
import { person, profiles } from '../data/public';
---
<Site title={person.name} description={person.summary}>
  <section class="identity" aria-labelledby="identity-title">
    <div class="identity-copy">
      <p class="coordinates"><Icon name="pin" /> {person.location}</p>
      <h1 id="identity-title">{person.name}</h1>
      <p class="position">{person.title}</p>
      <p class="intro" id="about">{person.summary}</p>
      <div class="identity-actions" id="contact">
        <a class="button primary" href={`mailto:${person.email}`}><Icon name="mail" />{person.email}</a>
        <a class="button secondary" href={telephoneHref}><Icon name="phone" />{telephoneLabel}</a>
        <a class="button secondary" href="/cv/"><Icon name="file" />View CV</a>
      </div>
    </div>
    <figure class="identity-art">
      <img src="/brand/monogram.webp" alt="Danilo Stoletović’s DS monogram" width="768" height="512" fetchpriority="high" />
    </figure>
  </section>
  <section class="site-directory" id="projects" aria-labelledby="directory-title">
    <div class="section-label">
      <h2 id="directory-title">Work & background</h2>
      <div class="profile-shortcuts">
        {profiles.filter(link => link.primary).map(link => <a href={link.url}><Icon name={link.icon} />{link.title}</a>)}
        <a href="/links/">All profiles <Icon name="arrow" /></a>
      </div>
    </div>
    <ul class="directory plain-list">
      {directories.map(item => <li id={item.href === '/commerce/' ? 'offers' : item.href === '/case/' ? 'case-studies' : undefined}>
        <a href={item.href} class="directory-link">
          <span class="directory-icon"><Icon name={item.icon} /></span>
          <span><strong>{item.title}</strong><small>{item.summary}</small></span>
          <Icon name="external" class="directory-arrow" />
        </a>
      </li>)}
    </ul>
    <a class="legacy-anchor" id="blog" href="/news/">News and recognition</a>
  </section>
</Site>
